```yaml
name: 🎮 Playit Agent

on:
  workflow_dispatch:

jobs:

  playit:

    name: 🎮 Setup Playit Agent
    runs-on: ubuntu-latest

    timeout-minutes: 360

    steps:

      # ============================================================
      # 1. SYSTEM INFORMATION
      # ============================================================

      - name: "1️⃣ 🖥️ System Information"
        shell: bash
        run: |
          set -e

          echo ""
          echo "=================================================="
          echo "PLAYIT AGENT RUNNER"
          echo "=================================================="
          echo ""

          echo "OS:"
          cat /etc/os-release

          echo ""
          echo "Kernel:"
          uname -a

          echo ""
          echo "CPU:"
          nproc
          lscpu | grep -E \
            'Model name|Socket|Core|Thread' \
            || true

          echo ""
          echo "MEMORY:"
          free -h

          echo ""
          echo "DISK:"
          df -h

          echo ""
          echo "NETWORK:"
          ip addr || true


      # ============================================================
      # 2. INSTALL DEPENDENCIES
      # ============================================================

      - name: "2️⃣ 📦 Install Dependencies"
        shell: bash
        run: |
          set -e

          echo ""
          echo "Installing dependencies..."

          sudo apt-get update

          sudo apt-get install -y \
            curl \
            ca-certificates \
            gnupg

          echo ""
          echo "Dependencies installed."


      # ============================================================
      # 3. INSTALL PLAYIT
      #
      # Official Playit Ubuntu/Debian repository
      # ============================================================

      - name: "3️⃣ 🎮 Install Playit"
        shell: bash
        run: |
          set -e

          echo ""
          echo "=================================================="
          echo "INSTALLING PLAYIT"
          echo "=================================================="
          echo ""

          curl -SsL \
            https://playit-cloud.github.io/ppa/key.gpg |
            gpg --dearmor |
            sudo tee /etc/apt/trusted.gpg.d/playit.gpg \
            >/dev/null

          echo \
            "deb [signed-by=/etc/apt/trusted.gpg.d/playit.gpg] https://playit-cloud.github.io/ppa/data ./" |
            sudo tee /etc/apt/sources.list.d/playit-cloud.list \
            >/dev/null

          sudo apt-get update

          sudo apt-get install -y playit

          echo ""
          echo "=================================================="
          echo "PLAYIT VERSION"
          echo "=================================================="
          echo ""

          playit version || true

          echo ""
          echo "Playit installation completed."


      # ============================================================
      # 4. VERIFY PLAYIT
      # ============================================================

      - name: "4️⃣ 🔎 Verify Playit"
        shell: bash
        run: |
          set -e

          echo ""
          echo "=================================================="
          echo "PLAYIT VERIFICATION"
          echo "=================================================="
          echo ""

          command -v playit

          echo ""
          echo "Binary:"
          readlink -f "$(command -v playit)" || true

          echo ""
          echo "Version:"
          playit version


      # ============================================================
      # 5. GENERATE CLAIM CODE
      #
      # The code is intentionally NOT exchanged automatically.
      # We will claim the agent manually through playit.gg.
      # ============================================================

      - name: "5️⃣ 🔐 Generate Claim Code"
        shell: bash
        run: |
          set -e

          echo ""
          echo "=================================================="
          echo "PLAYIT CLAIM"
          echo "=================================================="
          echo ""

          CLAIM_CODE="$(playit --stdout claim generate)"

          if [ -z "$CLAIM_CODE" ]; then
            echo "ERROR: Claim code was not generated."
            exit 1
          fi

          CLAIM_URL="https://playit.gg/claim/${CLAIM_CODE}"

          echo ""
          echo "╔══════════════════════════════════════════════════╗"
          echo "║              PLAYIT CLAIM CODE                  ║"
          echo "╚══════════════════════════════════════════════════╝"
          echo ""

          echo "Claim Code:"
          echo ""
          echo "$CLAIM_CODE"

          echo ""
          echo "Claim URL:"
          echo ""
          echo "$CLAIM_URL"

          echo ""
          echo "=================================================="
          echo "ACTION REQUIRED"
          echo "=================================================="
          echo ""
          echo "Open the Claim URL in your browser."
          echo ""
          echo "Or enter the Claim Code manually in:"
          echo "https://playit.gg"
          echo ""
          echo "After claiming the agent, continue with the"
          echo "Playit dashboard to create the game tunnel."
          echo ""

          {
            echo "PLAYIT_CLAIM_CODE=$CLAIM_CODE"
            echo "PLAYIT_CLAIM_URL=$CLAIM_URL"
          } >> "$GITHUB_ENV"


      # ============================================================
      # 6. START PLAYIT AGENT
      #
      # No secret is supplied here.
      #
      # The agent will remain in the claim/setup state until
      # the account-side claim is completed.
      # ============================================================

      - name: "6️⃣ 🚀 Start Playit Agent"
        shell: bash
        run: |
          set -e

          echo ""
          echo "=================================================="
          echo "STARTING PLAYIT AGENT"
          echo "=================================================="
          echo ""

          echo "Claim Code:"
          echo "$PLAYIT_CLAIM_CODE"

          echo ""
          echo "Claim URL:"
          echo "$PLAYIT_CLAIM_URL"

          echo ""
          echo "Starting Playit..."
          echo ""

          exec playit --stdout


      # ============================================================
      # 7. KEEP ALIVE
      #
      # This step is normally reached only if the agent process
      # exits. It keeps the workflow alive for diagnostics.
      # ============================================================

      - name: "7️⃣ ⏱️ Keep Alive"
        if: always()
        shell: bash
        run: |
          echo ""
          echo "=================================================="
          echo "PLAYIT WORKFLOW"
          echo "=================================================="
          echo ""

          while true
          do
            echo "Heartbeat: $(date -u)"

            if command -v playit >/dev/null 2>&1; then
              echo "Playit binary: OK"
            else
              echo "Playit binary: MISSING"
            fi

            sleep 600
          done
```
